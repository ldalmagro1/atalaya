{
  "name": "atalaya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "gateway",
    "web",
    "pr-reviewer",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n gateway,web,pr-reviewer -c blue,green,magenta \"npm run dev -w @atalaya/gateway\" \"npm run dev -w @atalaya/web\" \"npm run dev -w @atalaya/pr-reviewer\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "secrets:check": "secretlint \"**/*\""
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "9.1.7",
    "lodash": "4.17.20",
    "prettier": "^3.10.1",
    "secretlint": "14.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
