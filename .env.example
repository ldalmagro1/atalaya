# Gateway
GATEWAY_PORT=3001
INTERNAL_TOKEN=             # secreto aleatorio (32+ bytes) que el gateway envía a los servicios
DB_PATH=./data/atalaya.db

# Servicios
PR_REVIEWER_PORT=3101

# GitHub: fine-grained PAT limitado a los repos a usar, con los permisos
# Contents: Read-only, Pull requests: Read and write y Metadata: Read-only.
# Lo leen el gateway y los servicios que usan GitHub (ADR-001). Nunca lo pegue en el repo.
GITHUB_TOKEN=

# Jira (solo para las herramientas que lean Jira): URL del sitio, correo de la cuenta y API token
# (https://id.atlassian.com/manage-profile/security/api-tokens). Las tres o ninguna.
# Las lee el gateway (jira/check) y las herramientas que usen Jira. Nunca las pegue en el repo.
JIRA_BASE_URL=https://su-sitio.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Límites del revisor
MAX_INPUT_CHARS=300000
MAX_FILE_CHARS=30000
